# Copy this file to .env.production, replace every CHANGE_ME value, and keep
# the resulting file outside version control. URLs below are examples only.
NODE_ENV=production

# Host ports are loopback-only in docker-compose.self-hosted.yml.
BACKEND_PORT=3030
FRONTEND_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6379
STORAGE_S3_PORT=3900
LIVEKIT_PORT=7880

POSTGRES_DB=nebulynk
POSTGRES_USER=nebulynk
POSTGRES_PASSWORD=CHANGE_ME_STRONG_UNIQUE_POSTGRES_PASSWORD
GARAGE_RPC_SECRET=CHANGE_ME_64_HEX_CHARACTERS
STORAGE_S3_ACCESS_KEY=nebulynk
STORAGE_S3_SECRET_KEY=CHANGE_ME_STRONG_UNIQUE_STORAGE_SECRET
STORAGE_S3_BUCKET=nebulynk-files
STORAGE_S3_REGION=us-east-1

JWT_SECRET=CHANGE_ME_STRONG_UNIQUE_JWT_SECRET
AI_SECRET_KEY=CHANGE_ME_STRONG_UNIQUE_AI_ENCRYPTION_KEY
FRONTEND_URL=https://app.example.com
PASSKEY_RP_ID=app.example.com
TRUST_PROXY=true

LIVEKIT_API_KEY=nebulynk
LIVEKIT_API_SECRET=CHANGE_ME_STRONG_UNIQUE_LIVEKIT_SECRET
LIVEKIT_PUBLIC_URL=wss://livekit.example.com
STORAGE_S3_PUBLIC_ENDPOINT=https://files.example.com

# These values are baked into the frontend image at build time; never put a
# secret behind a VITE_ prefix.
VITE_API_URL=https://api.example.com
VITE_LIVEKIT_URL=wss://livekit.example.com
VITE_VAPID_PUBLIC_KEY=
VITE_AUTH_CSRF_COOKIE_NAME=nebulynk_csrf_token

# Optional: configuring SMTP enables invitations and security-update digests.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_IGNORE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Nebulynk

# Optional public build provenance shown in the administration Update Center.
NEBULYNK_BUILD_SHA=
NEBULYNK_BUILD_TIME=
