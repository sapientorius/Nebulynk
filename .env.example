# Runtime
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=nebulynk
POSTGRES_USER=nebulynk
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional single-value Redis connection string.
REDIS_URL=
# Default: memory in non-production, redis in production.
RATE_LIMIT_DRIVER=

# Security and backend
BACKEND_PORT=3030
# Production must replace this with a strong unique secret.
JWT_SECRET=change_me
# Optional dedicated secret for encrypting stored two-factor secrets. Empty
# uses JWT_SECRET as the backwards-compatible fallback.
AUTH_2FA_SECRET_KEY=
AUTHENTICATION_RATE_LIMIT_IP_LIMIT=
AUTH_BROWSER_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=1d
AUTH_REMEMBER_REFRESH_TOKEN_TTL=30d
AUTH_REFRESH_COOKIE_NAME=nebulynk_refresh_session
AUTH_CSRF_COOKIE_NAME=nebulynk_csrf_token
AUTH_COOKIE_DOMAIN=
# Recommended dedicated secret for encrypting stored AI provider secrets.
AI_SECRET_KEY=change_me_ai_secret
# Optional production override for intentional internal/self-hosted OpenAI-compatible endpoints.
# Comma-separated absolute HTTPS base URLs. Exact match after normalization only.
AI_PROVIDER_BASE_URL_ALLOWLIST=
FRONTEND_URL=http://127.0.0.1:5173
# WebAuthn RP ID for passkeys. Keep this aligned with the public frontend host or parent domain.
PASSKEY_RP_ID=127.0.0.1
# Production deployments behind Coolify, Nginx, Traefik, or another TLS terminator should set this to true
# and forward X-Forwarded-Proto=https so secure browser-session cookies can be issued.
TRUST_PROXY=false
# Optional additive platform-update verification keys as a JSON object keyed by
# key_id. Official keys are embedded; this public override is for controlled
# development or an overlapping emergency rotation, never private key material.
NEBULYNK_UPDATE_PUBLIC_KEYS_JSON=
# Optional immutable build provenance shown in the update center.
NEBULYNK_BUILD_SHA=
NEBULYNK_BUILD_TIME=
# Garage / S3-compatible object storage
# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=change_me_32_byte_hex_from_openssl_rand_hex_32
STORAGE_S3_ENDPOINT=http://127.0.0.1:3900
# Signed file URLs must target the S3/public asset endpoint.
STORAGE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:3900
STORAGE_S3_ACCESS_KEY=nebulynk
STORAGE_S3_SECRET_KEY=change_me
STORAGE_S3_BUCKET=nebulynk-files
STORAGE_S3_REGION=us-east-1

# Maximum retained personal, non-global video background images per user.
VIDEO_BACKGROUND_MAX_PER_USER=20

# Maximum retained personal, non-global video background images per user.
VIDEO_BACKGROUND_MAX_PER_USER=20
LIVEKIT_HOST=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_WS_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_livekit_secret
# Optional KLIPY GIF API fallback; can also be set in Platform Settings
KLIPY_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nebulynk.local
MEETING_RECORDINGS_PREFIX=meeting-recordings
MEETING_RECORDINGS_BUCKET=nebulynk-files
MEETING_RECORDINGS_S3_ENDPOINT=http://127.0.0.1:3900
MEETING_RECORDINGS_EGRESS_S3_ENDPOINT=http://garage:3900
MEETING_RECORDINGS_S3_REGION=us-east-1
MEETING_TRANSCRIPT_WAIT_TIMEOUT_MS=1800000
MEETING_AI_PROMPT_TRANSCRIPT_SEGMENTS=320
MEETING_AI_PROMPT_CHAT_MESSAGES=240
MEETING_AI_PROMPT_TRANSCRIPT_EXCERPT_CHARS=24000
MESSAGE_SUMMARY_MIN_CHARS=400
MESSAGE_SUMMARY_MAX_CONTEXT_CHARS=60000
SILENCE_DETECT_THRESHOLD_DB=-30
SILENCE_DETECT_MIN_DURATION_SEC=0.5
SILENCE_DETECT_MIN_SPEECH_SEC=0.3

# Frontend
FRONTEND_PORT=5173
VITE_AUTH_CSRF_COOKIE_NAME=nebulynk_csrf_token
VITE_MESSAGE_SUMMARY_MIN_CHARS=400
