$escape = static function ($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
};

$statusKey = (string)$this->state['deployment_status'];
$statusLabels = [
    'unconfigured' => 'Not configured yet',
    'configured' => 'Configuration saved',
    'checking' => 'Preflight check in progress',
    'ready' => 'Ready to use',
    'running' => 'Nebulynk is running',
    'stopped' => 'Stopped',
    'cleaning' => 'Full deletion in progress',
    'error' => 'Last task failed',
];
$statusClasses = [
    'unconfigured' => 'neutral',
    'configured' => 'neutral',
    'checking' => 'working',
    'ready' => 'success',
    'running' => 'success',
    'stopped' => 'neutral',
    'cleaning' => 'working',
    'error' => 'error',
];
$statusLabel = $statusLabels[$statusKey] ?? ($statusKey !== '' ? $statusKey : 'Not installed');
$statusClass = $statusClasses[$statusKey] ?? 'neutral';
$isBusy = in_array($statusKey, ['checking', 'cleaning'], true);
$isCleanupInProgress = $statusKey === 'cleaning';
$isOperational = in_array($statusKey, ['ready', 'running', 'stopped', 'error'], true);
$isRunning = $statusKey === 'running';
$domainName = (string)$this->state['domain_name'];
$logoUrl = rtrim((string)pm_Context::getBaseUrl(), '/') . '/images/nebulynk.png';
