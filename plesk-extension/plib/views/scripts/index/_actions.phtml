        </p>
    <?php endif; ?>

    <div class="nebulynk-callout nebulynk-callout-warning">
        <div class="nebulynk-callout-icon" aria-hidden="true">i</div>
        <div>
            <strong>Tasks may take several minutes</strong>
            <p>
                Nebulynk downloads container images, installs dependencies,
