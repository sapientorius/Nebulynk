<?php
$statusKey = (string)$this->state['deployment_status'];
$isOperational = in_array($statusKey, ['ready', 'running', 'stopped', 'error'], true);
$runtimeOutput = is_array($this->runtimeOutput) ? $this->runtimeOutput : null;
$escape = static function ($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
};
?>

<section class="form-box nebulynk-card nebulynk-action-card">
    <div class="nebulynk-section-head">
        <div>
            <p class="nebulynk-section-kicker"><?= $isOperational ? 'Operations' : 'Step 2' ?></p>
            <h3><?= $isOperational ? 'Actions' : 'Start setup' ?></h3>
        </div>
        <?php if ($isOperational): ?>
            <span class="nebulynk-tag">Management</span>
        <?php endif; ?>
    </div>
    <p class="nebulynk-card-intro">
        <?php if ($isOperational): ?>
            Control the Nebulynk service, check the container status, or view
            the latest logs.
        <?php else: ?>
            Select the prepared domain. Run the preflight check first,
            followed by the installation.
        <?php endif; ?>
    </p>

    <?php if (count($this->domains) === 0): ?>
        <div class="nebulynk-callout nebulynk-callout-error">
            <div class="nebulynk-callout-icon" aria-hidden="true">!</div>
            <div>
                <strong>No matching domain found</strong>
                <p>
                    First create an active Plesk domain with hosting, then
                    reload this page.
                </p>
            </div>
        </div>
    <?php endif; ?>

    <?= $this->form ?>

    <?php if ($runtimeOutput !== null): ?>
        <details class="form-box nebulynk-card nebulynk-output-card" open>
            <summary class="nebulynk-output-summary">
                <span class="nebulynk-output-title"><?= $escape($runtimeOutput['title']) ?></span>
            </summary>
            <pre class="nebulynk-output"><?= $escape($runtimeOutput['content']) ?></pre>
        </details>
    <?php endif; ?>

    <?php if ($isOperational): ?>
        <p class="nebulynk-form-note">
            <strong>Note:</strong>
            Start a new task only after the current task has completed in
