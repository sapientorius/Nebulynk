{
  "name": "Nebulynk",
  "short_name": "Nebulynk",
  "description": "Self-hosted collaboration platform for team chat, calls, and meetings.",
  "start_url": "/channels",
  "scope": "/",
  "display": "standalone",
  "background_color": "#18181c",
  "theme_color": "#18181c",
  "lang": "en",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url",
      "files": [
        {
          "name": "share_files",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/pwa-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
