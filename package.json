{
  "name": "nebulynk",
  "version": "0.2.1",
  "private": true,
  "description": "Self-hosted communication platform for business teams",
  "workspaces": [
    "backend",
    "frontend",
    "desktop-ptt-helper"
  ],
  "overrides": {
    "fast-uri": "4.1.2",
    "form-data": "4.0.6",
    "linkify-it": "6.1.0",
    "markdown-it": "15.0.0",
    "postcss": "8.5.25",
    "ws": "8.21.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:rtk": "npm run dev:rtk --workspace=backend & npm run dev:rtk --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:backend:rtk": "npm run dev:rtk --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:frontend:rtk": "npm run dev:rtk --workspace=frontend",
    "dev:desktop:ptt-helper": "npm run dev --workspace=desktop-ptt-helper",
    "dev:desktop:ptt-helper:rtk": "npm run dev:rtk --workspace=desktop-ptt-helper",
    "db:snapshot:save": "node scripts/db-snapshot.mjs save",
    "db:snapshot:save:rtk": "rtk node scripts/db-snapshot.mjs save",
    "db:snapshot:list": "node scripts/db-snapshot.mjs list",
    "db:snapshot:list:rtk": "rtk node scripts/db-snapshot.mjs list",
    "db:snapshot:restore": "node scripts/db-snapshot.mjs restore",
    "db:snapshot:restore:rtk": "rtk node scripts/db-snapshot.mjs restore",
    "db:snapshot:delete": "node scripts/db-snapshot.mjs delete",
    "db:snapshot:delete:rtk": "rtk node scripts/db-snapshot.mjs delete",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "lint:rtk": "rtk npm run lint:rtk --workspace=backend && rtk npm run lint:rtk --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:backend:rtk": "rtk npm run test:rtk --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:frontend:rtk": "rtk npm run test:rtk --workspace=frontend",
    "test:e2e": "npm run test:e2e --workspace=frontend",
    "test:e2e:rtk": "rtk npm run test:e2e:rtk --workspace=frontend",
    "screenshots": "npm run seed:demo:en --workspace=backend -- --reset && npm run test:e2e --workspace=frontend -- --config=playwright.screenshots.config.js",
    "screenshots:backend": "npm run start --workspace=backend",
    "e2e:backend": "npm run e2e:reset-db --workspace=backend && npm run start --workspace=backend",
    "e2e:backend:rtk": "rtk npm run e2e:reset-db:rtk --workspace=backend && rtk npm run start --workspace=backend",
    "e2e:frontend": "npm run e2e:dev --workspace=frontend",
    "e2e:frontend:rtk": "rtk npm run e2e:dev:rtk --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:frontend:rtk": "rtk npm run build:rtk --workspace=frontend",
    "build:desktop:ptt-helper": "npm run build --workspace=desktop-ptt-helper",
    "build:desktop:ptt-helper:rtk": "rtk npm run build:rtk --workspace=desktop-ptt-helper",
    "security:deps": "npm audit --workspaces --include-workspace-root --audit-level=high",
    "security:deps:rtk": "rtk npm audit --workspaces --include-workspace-root --audit-level=high",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:check:rtk": "rtk node scripts/i18n-check.mjs",
    "i18n:add-locale": "node scripts/i18n-add-locale.mjs",
    "i18n:add-locale:rtk": "rtk node scripts/i18n-add-locale.mjs",
    "release:validate": "node scripts/validate-releases.mjs",
    "release:validate:rtk": "rtk node scripts/validate-releases.mjs",
    "release:build-feed": "node scripts/build-update-feed.mjs",
    "release:build-feed:rtk": "rtk node scripts/build-update-feed.mjs",
    "release:verify-feed": "node scripts/verify-update-feed.mjs",
    "release:verify-feed:rtk": "rtk node scripts/verify-update-feed.mjs",
    "release:assert-feed-advance": "node scripts/assert-update-feed-advance.mjs",
    "release:assert-feed-advance:rtk": "rtk node scripts/assert-update-feed-advance.mjs",
    "release:notes": "node scripts/render-release-notes.mjs",
    "release:notes:rtk": "rtk node scripts/render-release-notes.mjs",
    "release:keygen": "node scripts/generate-update-signing-key.mjs",
    "release:keygen:rtk": "rtk node scripts/generate-update-signing-key.mjs",
    "release:validate-keyring": "node scripts/validate-update-keyring.mjs",
    "release:validate-keyring:rtk": "rtk node scripts/validate-update-keyring.mjs",
    "ci": "npm run lint && npm run i18n:check && npm run test:backend && npm run test:frontend && npm run build:frontend",
    "ci:rtk": "rtk npm run lint:rtk && rtk npm run i18n:check:rtk && rtk npm run test:backend:rtk && rtk npm run test:frontend:rtk && rtk npm run build:frontend:rtk",
    "docker:up": "docker compose up -d",
    "docker:up:rtk": "rtk docker compose up -d",
    "docker:down": "docker compose down",
    "docker:down:rtk": "rtk docker compose down"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "semver": "^7.7.2"
  }
}
