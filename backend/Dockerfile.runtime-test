FROM node:22.23.4-alpine3.24@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
WORKDIR /app
RUN apk add --no-cache ffmpeg
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
RUN npm ci --workspace=backend
COPY backend ./backend
RUN test -f backend/test/helpers/postgres-test-db.js && test -f backend/test/runtime.test.js
RUN chown -R node:node /app
USER node
WORKDIR /app/backend
CMD ["node", "scripts/runtime-benchmark-client.mjs"]
