{
  "name": "nebulynk-backend",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Nebulynk Backend API",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:rtk": "rtk node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "node scripts/lint.mjs",
    "lint:rtk": "rtk node scripts/lint.mjs",
    "test": "node --test test/**/*.test.js",
    "test:rtk": "rtk node --test test/**/*.test.js",
    "e2e:reset-db": "node scripts/e2e-reset-db.mjs",
    "e2e:reset-db:rtk": "rtk node scripts/e2e-reset-db.mjs",
    "seed:demo": "node scripts/seed-demo-db.mjs",
    "seed:demo:rtk": "rtk node scripts/seed-demo-db.mjs",
    "seed:demo:en": "node scripts/seed-demo-db-en.mjs",
    "seed:demo:en:rtk": "rtk node scripts/seed-demo-db-en.mjs",
    "seed:presence": "node scripts/simulate-presence.mjs",
    "seed:presence:rtk": "rtk node scripts/simulate-presence.mjs",
    "seed:presence:en": "node scripts/simulate-presence-en.mjs",
    "seed:presence:en:rtk": "rtk node scripts/simulate-presence-en.mjs",
    "backfill:meeting-start-members": "node scripts/backfill-meeting-start-members.mjs",
    "backfill:meeting-start-members:rtk": "rtk node scripts/backfill-meeting-start-members.mjs",
    "seed:meeting-history-benchmark": "node scripts/seed-meeting-history-benchmark.mjs",
    "seed:meeting-history-benchmark:rtk": "rtk node scripts/seed-meeting-history-benchmark.mjs",
    "benchmark:meeting-history": "node scripts/benchmark-meeting-history-access.mjs",
    "benchmark:meeting-history:rtk": "rtk node scripts/benchmark-meeting-history-access.mjs",
    "db:switch": "node scripts/switch-db.mjs",
    "db:switch:rtk": "rtk node scripts/switch-db.mjs",
    "migrate": "knex migrate:latest",
    "migrate:rtk": "rtk knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:make:rtk": "rtk knex migrate:make",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:rollback:rtk": "rtk knex migrate:rollback"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.993.0",
    "@aws-sdk/s3-request-presigner": "^3.993.0",
    "@feathersjs/authentication": "^5.0.40",
    "@feathersjs/authentication-local": "^5.0.40",
    "@feathersjs/configuration": "^5.0.40",
    "@feathersjs/errors": "^5.0.40",
    "@feathersjs/feathers": "^5.0.40",
    "@feathersjs/knex": "^5.0.40",
    "@feathersjs/koa": "^5.0.40",
    "@feathersjs/socketio": "^5.0.40",
    "@paralleldrive/cuid2": "^3.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.3.1",
    "formidable": "^3.5.4",
    "knex": "^3.1.0",
    "livekit-server-sdk": "^2.15.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "redis": "^5.12.1",
    "semver": "^7.7.2",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "yazl": "^3.3.1"
  }
